```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py~

# Dependencies
venv/
.venv/
.env
.env.local
*.env.*

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo

# Coverage reports
coverage/
htmlcov/
.coverage

# Database
db.sqlite3
*.db

# OS generated files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Build artifacts
dist/
build/
target/
*.egg-info/

# Cache directories
.mypy_cache/
.pytest_cache/
.coverage/
htmlcov/

# System files
*.swp
*.swo
*~
```